{
  "name": "expense-tracker",
  "main": "index.js",
  "compatibility_date": "2025-07-27",
  "assets": {
    "directory": "./public/"
  },
  "env": {
    "production": {
      "routes": [
        {
          "pattern": "expensetracker.hgnlab.org",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "D1_DATABASE",
          "database_name": "mony",
          "database_id": "PRODUCTION_D1_DATABASE_ID_PLACEHOLDER"
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "ANALYTICS_TEST",
          "dataset": "ANALYTICS_TEST"
        }
      ],
      "ai": {
        "binding": "AI"
      }
    },
    "development": {
      "d1_databases": [
        {
          "binding": "D1_DATABASE",
          "database_name": "mony-development-db",
          "database_id": "ea700681-91ef-4825-bbe4-7ee90f9519be"
        }
      ],
      "ai": {
        "binding": "AI"
      }
    },
    "staging": {
      "routes": [
        {
          "pattern": "stagetracker.hgnlab.org",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "D1_DATABASE",
          "database_name": "mony-staging-db",
          "database_id": "STAGING_D1_DATABASE_ID_PLACEHOLDER"
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "ANALYTICS_TEST",
          "dataset": "ANALYTICS_TEST"
        }
      ],
      "ai": {
        "binding": "AI"
      }
    }
  }
}
